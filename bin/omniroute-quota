#!/usr/bin/env python3
import sys
import os
import json
import time
import urllib.request
import urllib.error
from pathlib import Path
from datetime import datetime

HOME = Path(os.environ.get("HOME", "/tmp"))
CONFIG_PATH = HOME / ".config/omarchy/omniroute-quota.json"
STATE_DIR = HOME / ".local/state/omarchy/omniroute-quota"
STATE_FILE = STATE_DIR / "state.json"

DEFAULT_CONFIG = {
    "endpoint": "https://omniroute.home.priyeshbhawsar.com",
    "token": "sk-cbd864e458119963-45d2d6-e35a047c",
    "refreshIntervalSeconds": 60,
    "targetScreen": "DP-4",
    "position": "top-right",
    "width": 380,
    "topMargin": 48,
    "rightMargin": 16
}

def load_config():
    if not CONFIG_PATH.is_file():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return DEFAULT_CONFIG
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return {**DEFAULT_CONFIG, **data}
    except Exception:
        return DEFAULT_CONFIG

def format_duration(ms):
    if not ms or ms <= 0: return "Active"
    seconds = int(ms / 1000)
    days = seconds // 86400
    hours = (seconds % 86400) // 3600
    minutes = (seconds % 3600) // 60
    if days > 0:
        return f"Reset in {days}d {hours}h"
    elif hours > 0:
        return f"Reset in {hours}h {minutes}m"
    elif minutes > 0:
        return f"Reset in {minutes}m"
    else:
        return f"Reset in {seconds}s"

def parse_iso_duration(iso_str):
    if not iso_str: return None
    try:
        dt = datetime.fromisoformat(iso_str.replace("Z", "+00:00"))
        rem_seconds = int(dt.timestamp() - time.time())
        if rem_seconds > 0:
            return format_duration(rem_seconds * 1000)
    except Exception:
        pass
    return None

def fetch_data():
    config = load_config()
    endpoint = config.get("endpoint", "https://omniroute.home.priyeshbhawsar.com").rstrip("/")
    token = config.get("token", "").strip()
    
    headers = {
        "User-Agent": "OmniRoute-Quickshell-Widget/1.0",
        "Accept": "application/json"
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    
    result = {
        "status": "ok",
        "lastUpdated": int(time.time()),
        "endpoint": endpoint,
        "codex": {
            "name": "OpenAI Codex",
            "plan": "ChatGPT Plus",
            "fiveHour": { "status": "active", "percent": 100, "label": "5-Hour Window", "text": "Active (Sliding 5h Window)" },
            "weekly": { "status": "active", "percent": 100, "label": "Weekly Limit", "text": "Active (7-Day Rolling Limit)" }
        },
        "copilot": {
            "name": "GitHub Copilot",
            "plan": "Business Seat Quota",
            "status": "active",
            "percent": 100,
            "quotaText": "Unlimited Premium Quota",
            "detail": "Seat License Active · Token Valid"
        },
        "antigravity": {
            "account": "priyeshbhawsar15@gmail.com",
            "tier": "Google AI Pro",
            "status": "active",
            "models": []
        },
        "otherProviders": [],
        "totalActive": 0,
        "error": None
    }
    
    # 1. Cooldowns
    cooldowns = []
    try:
        req_cd = urllib.request.Request(f"{endpoint}/api/resilience/model-cooldowns", headers=headers)
        with urllib.request.urlopen(req_cd, timeout=5) as resp:
            cd_data = json.loads(resp.read().decode("utf-8"))
            cooldowns = cd_data.get("items", [])
    except Exception:
        pass

    # 2. Connections
    connections = []
    try:
        req = urllib.request.Request(f"{endpoint}/api/providers", headers=headers)
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            connections = data.get("connections", [])
    except Exception as e:
        result["status"] = "error"
        result["error"] = str(e)
        save_state(result)
        return result

    # --- PROCESS OPENAI CODEX (5h & Weekly Windows) ---
    for c in connections:
        if c.get("provider") == "codex":
            p_data = c.get("providerSpecificData") or {}
            plan = p_data.get("workspacePlanType", "Plus").title()
            result["codex"]["plan"] = f"ChatGPT {plan}"
            
            pool = c.get("codexAccountPool") or {}
            children = pool.get("children", [])
            has_5h_limit = False
            has_7d_limit = False
            
            for child in children:
                scope = child.get("key", {}).get("scope")
                if scope == "codex":
                    cooldown = child.get("cooldown") or {}
                    windows = child.get("quota", {}).get("windows") or {}
                    
                    if cooldown.get("active"):
                        rl_until = cooldown.get("rateLimitedUntil")
                        dur_text = parse_iso_duration(rl_until) or "Rate Limited"
                        result["codex"]["fiveHour"] = { "status": "exhausted", "percent": 0, "label": "5-Hour Window", "text": f"Limited · {dur_text}" }
                        has_5h_limit = True
                    
                    if windows.get("7d"):
                        result["codex"]["weekly"] = { "status": "exhausted", "percent": 0, "label": "Weekly Limit", "text": "Weekly Limit Reached" }
                        has_7d_limit = True
                    elif windows.get("5h") and not has_5h_limit:
                        result["codex"]["fiveHour"] = { "status": "exhausted", "percent": 0, "label": "5-Hour Window", "text": "5h Window Reached" }
                        has_5h_limit = True
            
            if not has_5h_limit:
                result["codex"]["fiveHour"] = { "status": "active", "percent": 100, "label": "5-Hour Window", "text": "100% Available (Sliding Window)" }
            if not has_7d_limit:
                result["codex"]["weekly"] = { "status": "active", "percent": 100, "label": "Weekly Limit", "text": "100% Available (7-Day Limit)" }

    # --- PROCESS GITHUB COPILOT (Premium Requests) ---
    for c in connections:
        if c.get("provider") == "github":
            p_data = c.get("providerSpecificData") or {}
            copilot_token = p_data.get("copilotToken", "")
            exp_ts = p_data.get("copilotTokenExpiresAt")
            exp_text = ""
            if exp_ts:
                rem_s = int(exp_ts - time.time())
                if rem_s > 0:
                    exp_text = f"Token renews in {rem_s // 3600}h {(rem_s % 3600) // 60}m"
            
            sku_name = "Business Seat Quota"
            if "sku=" in copilot_token:
                try:
                    sku_part = [p for p in copilot_token.split(";") if p.startswith("sku=")][0]
                    sku_name = sku_part.split("=")[1].replace("_", " ").title()
                except Exception:
                    pass
            
            result["copilot"] = {
                "name": "GitHub Copilot",
                "plan": sku_name,
                "status": "active" if c.get("isActive") else "disabled",
                "percent": 100 if c.get("isActive") else 0,
                "quotaText": "Unlimited Premium Requests",
                "detail": exp_text if exp_text else "Seat Quota Active"
            }

    # --- PROCESS GOOGLE ANTIGRAVITY (PRO ACCOUNT ONLY) ---
    pro_conns = [c for c in connections if c.get("provider") == "antigravity" and (
        c.get("providerSpecificData", {}).get("plan") == "Pro" or 
        c.get("providerSpecificData", {}).get("tier") == "g1-pro-tier" or 
        "pro" in str(c.get("providerSpecificData", {}).get("subscriptionTier", "")).lower()
    )]
    
    pro_conn = pro_conns[0] if pro_conns else None
    if pro_conn:
        pro_id = pro_conn.get("id", "")
        pro_email = pro_conn.get("email") or pro_conn.get("name") or "Pro Account"
        pro_plan = pro_conn.get("providerSpecificData", {}).get("subscriptionTier", "Google AI Pro")
        
        result["antigravity"]["account"] = pro_email
        result["antigravity"]["tier"] = pro_plan
        result["antigravity"]["status"] = "active" if pro_conn.get("isActive") else "inactive"
        
        # Check cooldowns on this specific Pro connection
        pro_cooldowns = [cd for cd in cooldowns if cd.get("connectionId") == pro_id or (cd.get("provider") == "antigravity" and not cd.get("connectionId"))]
        
        gemini_models = [
            { "id": "gemini-2.5-pro", "name": "Gemini 2.5 Pro", "tag": "2.5 Pro", "raw": "gemini-2.5-pro" },
            { "id": "gemini-2.5-flash", "name": "Gemini 2.5 Flash", "tag": "2.5 Flash", "raw": "gemini-2.5-flash" },
            { "id": "gemini-3.7-flash", "name": "Gemini 3.7 Flash High", "tag": "3.7 Flash", "raw": "gemini-3.7-flash-high" },
            { "id": "claude-sonnet", "name": "Claude 3.7 Sonnet (AG)", "tag": "Claude 3.7 Sonnet", "raw": "claude-sonnet" }
        ]
        
        pro_model_cards = []
        for gm in gemini_models:
            m_raw = gm["raw"]
            matched = [cd for cd in pro_cooldowns if m_raw in cd.get("model", "")]
            if matched:
                max_rem = max([cd.get("remainingMs", 0) for cd in matched])
                dur_text = format_duration(max_rem)
                pro_model_cards.append({
                    "name": gm["name"],
                    "tag": gm["tag"],
                    "status": "exhausted",
                    "percent": 0,
                    "detail": f"Quota Exhausted · {dur_text}",
                    "icon": "󰊭"
                })
            else:
                pro_model_cards.append({
                    "name": gm["name"],
                    "tag": gm["tag"],
                    "status": "active",
                    "percent": 100,
                    "detail": "100% Pro Quota Available",
                    "icon": "󰊭"
                })
        result["antigravity"]["models"] = pro_model_cards

    # Other providers
    others = []
    for c in connections:
        prov = c.get("provider")
        if prov in ("codex", "antigravity", "github"): continue
        is_act = c.get("isActive", True)
        name_map = { "chatgpt-web": "ChatGPT Web", "openrouter": "OpenRouter", "aihorde": "AI Horde" }
        d_name = name_map.get(prov, prov.replace("-", " ").title())
        others.append({
            "name": d_name,
            "provider": prov,
            "status": "active" if is_act else "disabled",
            "percent": 100 if is_act else 0,
            "detail": "Connected & Active" if is_act else "Disabled"
        })
    result["otherProviders"] = others
    result["totalActive"] = len([c for c in connections if c.get("isActive")])
    
    save_state(result)
    return result

def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")

def get_state():
    if STATE_FILE.is_file():
        try: return json.loads(STATE_FILE.read_text())
        except Exception: pass
    return fetch_data()

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    if cmd == "fetch" or cmd == "refresh":
        print(json.dumps(fetch_data(), indent=2))
    elif cmd == "get" or cmd == "status":
        print(json.dumps(get_state(), indent=2))
    elif cmd == "config":
        print(json.dumps(load_config(), indent=2))
    else:
        print(json.dumps({"error": f"Unknown command: {cmd}"}))
        sys.exit(1)

if __name__ == "__main__":
    main()
