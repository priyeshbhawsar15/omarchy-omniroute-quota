#!/usr/bin/env python3
import sys
import os
import json
import time
import urllib.request
import urllib.error
from pathlib import Path
from datetime import datetime

HOME = Path(os.environ.get("HOME", "/tmp"))
CONFIG_PATH = HOME / ".config/omarchy/omniroute-quota.json"
STATE_DIR = HOME / ".local/state/omarchy/omniroute-quota"
STATE_FILE = STATE_DIR / "state.json"

DEFAULT_CONFIG = {
    "endpoint": "https://omniroute.home.priyeshbhawsar.com",
    "token": "sk-cbd864e458119963-45d2d6-e35a047c",
    "refreshIntervalSeconds": 15,
    "targetScreen": "DP-4",
    "position": "top-right",
    "width": 390,
    "topMargin": 48,
    "rightMargin": 16
}

def load_config():
    if not CONFIG_PATH.is_file():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return DEFAULT_CONFIG
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return {**DEFAULT_CONFIG, **data}
    except Exception:
        return DEFAULT_CONFIG

def format_duration(ms):
    if not ms or ms <= 0: return "Active"
    seconds = int(ms / 1000)
    days = seconds // 86400
    hours = (seconds % 86400) // 3600
    minutes = (seconds % 3600) // 60
    if days > 0:
        return f"Reset in {days}d {hours}h"
    elif hours > 0:
        return f"Reset in {hours}h {minutes}m"
    elif minutes > 0:
        return f"Reset in {minutes}m"
    else:
        return f"Reset in {seconds}s"

def parse_iso_duration(iso_str):
    if not iso_str: return None
    try:
        dt = datetime.fromisoformat(iso_str.replace("Z", "+00:00"))
        rem_seconds = int(dt.timestamp() - time.time())
        if rem_seconds > 0:
            return format_duration(rem_seconds * 1000)
    except Exception:
        pass
    return None

def fetch_data():
    config = load_config()
    endpoint = config.get("endpoint", "https://omniroute.home.priyeshbhawsar.com").rstrip("/")
    token = config.get("token", "").strip()
    
    headers = {
        "User-Agent": "OmniRoute-Quickshell-Widget/1.0",
        "Accept": "application/json"
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    
    result = {
        "status": "ok",
        "lastUpdated": int(time.time()),
        "endpoint": endpoint,
        "copilot": {
            "name": "GitHub Copilot",
            "plan": "Business Seat Quota",
            "status": "active",
            "percent": 100,
            "quotaText": "100% Available",
            "detail": "Seat License Active"
        },
        "codex": {
            "name": "OpenAI Codex",
            "plan": "ChatGPT Plus",
            "fiveHour": {
                "status": "active",
                "percent": 100,
                "label": "5-Hour Session Window",
                "text": "100% Available (Session Window)"
            },
            "weekly": {
                "status": "active",
                "percent": 100,
                "label": "Weekly Rolling Limit",
                "text": "100% Available (7-Day Limit)"
            }
        },
        "antigravityPro": {
            "account": "priyeshbhawsar15@gmail.com",
            "tier": "Google AI Pro",
            "status": "active",
            "percent": 100,
            "quotaText": "100% Pro Quota Available",
            "detail": "Active Tier · No Cooldowns",
            "models": [
                {
                    "name": "Gemini (Google AI Pro)",
                    "tag": "Gemini Pro",
                    "percent": 100,
                    "status": "active",
                    "detail": "100% Pro Quota Available",
                    "icon": "󰊭"
                }
            ]
        },
        "totalActive": 0,
        "error": None
    }
    
    # 1. Live Cooldowns Request
    cooldowns = []
    try:
        req_cd = urllib.request.Request(f"{endpoint}/api/resilience/model-cooldowns", headers=headers)
        with urllib.request.urlopen(req_cd, timeout=6) as resp:
            cd_data = json.loads(resp.read().decode("utf-8"))
            cooldowns = cd_data.get("items", [])
    except Exception:
        pass

    # 2. Live Providers Request
    connections = []
    try:
        req = urllib.request.Request(f"{endpoint}/api/providers", headers=headers)
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            connections = data.get("connections", [])
    except Exception as e:
        result["status"] = "error"
        result["error"] = str(e)
        save_state(result)
        return result

    # --- 1. GITHUB COPILOT LIVE TELEMETRY ---
    for c in connections:
        if c.get("provider") == "github":
            p_data = c.get("providerSpecificData") or {}
            copilot_token = p_data.get("copilotToken", "")
            exp_ts = p_data.get("copilotTokenExpiresAt")
            is_active = c.get("isActive", True)
            
            copilot_cds = [cd for cd in cooldowns if cd.get("provider") == "github"]
            
            exp_text = "Seat License Active"
            if exp_ts:
                rem_s = int(exp_ts - time.time())
                if rem_s > 0:
                    exp_text = f"Token renews in {rem_s // 3600}h {(rem_s % 3600) // 60}m"
            
            sku_name = "Business Seat Quota"
            if "sku=" in copilot_token:
                try:
                    sku_part = [p for p in copilot_token.split(";") if p.startswith("sku=")][0]
                    sku_name = sku_part.split("=")[1].replace("_", " ").title()
                except Exception:
                    pass
            
            copilot_pct = 100
            status = "active" if is_active else "disabled"
            quota_text = "Unlimited Premium Quota"
            detail_text = f"Requests Available · {exp_text}"
            
            if copilot_cds:
                max_cd = max([cd.get("remainingMs", 0) for cd in copilot_cds])
                dur_text = format_duration(max_cd)
                models_affected = ", ".join(sorted(list({cd.get("model", "") for cd in copilot_cds})))
                copilot_pct = 0
                status = "exhausted"
                quota_text = f"Cooldown ({models_affected})"
                detail_text = f"{models_affected} on cooldown · {dur_text}"
                
            if not is_active:
                copilot_pct = 0
                status = "disabled"
                quota_text = "0% Quota · Disabled"
                detail_text = "Connection Paused"
            
            result["copilot"] = {
                "name": "GitHub Copilot",
                "plan": sku_name,
                "status": status,
                "percent": copilot_pct,
                "quotaText": quota_text,
                "detail": detail_text
            }

    # --- 2. OPENAI CODEX LIVE TELEMETRY ---
    for c in connections:
        if c.get("provider") == "codex":
            p_data = c.get("providerSpecificData") or {}
            plan = p_data.get("workspacePlanType", "Plus").title()
            result["codex"]["plan"] = f"ChatGPT {plan}"
            is_active = c.get("isActive", True)
            
            pool = c.get("codexAccountPool") or {}
            children = pool.get("children", [])
            
            five_hour_pct = 100
            weekly_pct = 100
            five_hour_status = "active" if is_active else "disabled"
            weekly_status = "active" if is_active else "disabled"
            five_hour_text = "100% Available (Session Window)"
            weekly_text = "100% Available (7-Day Limit)"
            
            for child in children:
                scope = child.get("key", {}).get("scope")
                if scope == "codex":
                    cooldown = child.get("cooldown") or {}
                    windows = child.get("quota", {}).get("windows") or {}
                    
                    if cooldown.get("active"):
                        rl_until = cooldown.get("rateLimitedUntil")
                        dur_text = parse_iso_duration(rl_until)
                        five_hour_text = f"Limited · {dur_text}" if dur_text else "Rate Limited"
                        five_hour_status = "exhausted"
                        five_hour_pct = 0
                        
                    if windows.get("7d"):
                        weekly_status = "exhausted"
                        weekly_pct = 0
                        weekly_text = "0% Available (Weekly Limit Reached)"
            
            if not is_active:
                five_hour_pct = 0
                weekly_pct = 0
                five_hour_status = "disabled"
                weekly_status = "disabled"
                five_hour_text = "Disabled"
                weekly_text = "Disabled"
            
            result["codex"]["fiveHour"] = {
                "status": five_hour_status,
                "percent": five_hour_pct,
                "label": "5-Hour Session Window",
                "text": five_hour_text
            }
            result["codex"]["weekly"] = {
                "status": weekly_status,
                "percent": weekly_pct,
                "label": "Weekly Rolling Limit",
                "text": weekly_text
            }

    # --- 3. GOOGLE ANTIGRAVITY (PRO ACCOUNT) LIVE TELEMETRY ---
    pro_conns = [c for c in connections if c.get("provider") == "antigravity" and (
        c.get("providerSpecificData", {}).get("plan") == "Pro" or 
        c.get("providerSpecificData", {}).get("tier") == "g1-pro-tier" or 
        "pro" in str(c.get("providerSpecificData", {}).get("subscriptionTier", "")).lower()
    )]
    
    pro_conn = pro_conns[0] if pro_conns else None
    if pro_conn:
        pro_id = pro_conn.get("id", "")
        pro_email = pro_conn.get("email") or pro_conn.get("name") or "Pro Account"
        pro_tier = pro_conn.get("providerSpecificData", {}).get("subscriptionTier", "Google AI Pro")
        is_active = pro_conn.get("isActive", True)
        
        pro_cds = [cd for cd in cooldowns if cd.get("connectionId") == pro_id]
        
        ag_pct = 100
        pro_status = "active" if is_active else "disabled"
        pro_detail = "100% Pro Quota Available · Active Tier"
        
        if pro_cds:
            max_cd = max([cd.get("remainingMs", 0) for cd in pro_cds])
            dur_text = format_duration(max_cd)
            models_affected = ", ".join(sorted(list({cd.get("model", "") for cd in pro_cds})))
            ag_pct = 0
            pro_status = "exhausted"
            pro_detail = f"{models_affected} exhausted · {dur_text}"
        elif not is_active:
            ag_pct = 0
            pro_status = "disabled"
            pro_detail = "0% Quota · Account Paused"
            
        result["antigravityPro"] = {
            "account": pro_email,
            "tier": pro_tier,
            "status": pro_status,
            "percent": ag_pct,
            "quotaText": f"{ag_pct}% Pro Quota Left" if ag_pct < 100 else "100% Pro Quota Available",
            "detail": pro_detail,
            "models": [
                {
                    "name": "Gemini (Google AI Pro)",
                    "tag": "Gemini Pro",
                    "percent": ag_pct,
                    "status": pro_status,
                    "detail": pro_detail,
                    "icon": "󰊭"
                }
            ]
        }
    
    result["totalActive"] = len([c for c in connections if c.get("isActive")])
    save_state(result)
    return result

def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")

def get_state():
    if STATE_FILE.is_file():
        try: return json.loads(STATE_FILE.read_text())
        except Exception: pass
    return fetch_data()

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    if cmd == "fetch" or cmd == "refresh":
        print(json.dumps(fetch_data(), indent=2))
    elif cmd == "get" or cmd == "status":
        print(json.dumps(get_state(), indent=2))
    elif cmd == "config":
        print(json.dumps(load_config(), indent=2))
    else:
        print(json.dumps({"error": f"Unknown command: {cmd}"}))
        sys.exit(1)

if __name__ == "__main__":
    main()
