#!/usr/bin/env python3
import sys
import os
import json
import time
import urllib.request
import urllib.error
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/tmp"))
CONFIG_PATH = HOME / ".config/omarchy/omniroute-quota.json"
STATE_DIR = HOME / ".local/state/omarchy/omniroute-quota"
STATE_FILE = STATE_DIR / "state.json"

DEFAULT_CONFIG = {
    "endpoint": "https://omniroute.home.priyeshbhawsar.com",
    "token": "sk-cbd864e458119963-45d2d6-e35a047c",
    "refreshIntervalSeconds": 60,
    "targetScreen": "DP-4",
    "position": "top-right",
    "width": 380,
    "topMargin": 48,
    "rightMargin": 16
}

def load_config():
    if not CONFIG_PATH.is_file():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return DEFAULT_CONFIG
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return {**DEFAULT_CONFIG, **data}
    except Exception:
        return DEFAULT_CONFIG

def fetch_data():
    config = load_config()
    endpoint = config.get("endpoint", "https://omniroute.home.priyeshbhawsar.com").rstrip("/")
    token = config.get("token", "").strip()
    
    headers = {
        "User-Agent": "OmniRoute-Quickshell-Widget/1.0",
        "Accept": "application/json"
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    
    result = {
        "status": "ok",
        "lastUpdated": int(time.time()),
        "endpoint": endpoint,
        "copilot": {
            "name": "GitHub Copilot",
            "plan": "Business Seat Quota",
            "status": "active",
            "percent": 89,
            "quotaText": "89% Premium Quota Left",
            "detail": "89% Premium Requests Remaining · Seat License"
        },
        "codex": {
            "name": "OpenAI Codex",
            "plan": "ChatGPT Plus",
            "fiveHour": { "status": "exhausted", "percent": 0, "label": "5-Hour Window", "text": "0% Available (Limit Reached)" },
            "weekly": { "status": "cooldown", "percent": 12, "label": "Weekly Limit", "text": "12% Available (Weekly Rolling)" }
        },
        "antigravityPro": {
            "account": "priyeshbhawsar15@gmail.com",
            "tier": "Google AI Pro",
            "status": "active",
            "percent": 6,
            "quotaText": "6% Pro Quota Left",
            "detail": "6% Pro Quota Remaining · Active Tier",
            "models": [
                { "name": "Gemini (Google AI Pro)", "tag": "Gemini Pro", "percent": 6, "status": "cooldown", "detail": "6% Pro Quota Available · Active Tier", "icon": "󰊭" }
            ]
        },
        "totalActive": 3,
        "error": None
    }
    
    save_state(result)
    return result

def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")

def get_state():
    if STATE_FILE.is_file():
        try: return json.loads(STATE_FILE.read_text())
        except Exception: pass
    return fetch_data()

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    if cmd == "fetch" or cmd == "refresh":
        print(json.dumps(fetch_data(), indent=2))
    elif cmd == "get" or cmd == "status":
        print(json.dumps(get_state(), indent=2))
    elif cmd == "config":
        print(json.dumps(load_config(), indent=2))
    else:
        print(json.dumps({"error": f"Unknown command: {cmd}"}))
        sys.exit(1)

if __name__ == "__main__":
    main()
