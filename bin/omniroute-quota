#!/usr/bin/env python3
import sys
import os
import json
import time
import urllib.request
import urllib.error
from pathlib import Path
from datetime import datetime

HOME = Path(os.environ.get("HOME", "/tmp"))
CONFIG_PATH = HOME / ".config/omarchy/omniroute-quota.json"
STATE_DIR = HOME / ".local/state/omarchy/omniroute-quota"
STATE_FILE = STATE_DIR / "state.json"

DEFAULT_CONFIG = {
    "endpoint": "https://omniroute.home.priyeshbhawsar.com",
    "token": "sk-cbd864e458119963-45d2d6-e35a047c",
    "refreshIntervalSeconds": 15,
    "targetScreen": "DP-4",
    "position": "top-right",
    "width": 390,
    "topMargin": 48,
    "rightMargin": 16,
    "quotas": {
        "geminiPercent": 53,
        "githubPercent": 0,
        "codexSessionPercent": 100,
        "codexWeeklyPercent": 0
    }
}

def load_config():
    if not CONFIG_PATH.is_file():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return DEFAULT_CONFIG
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return {**DEFAULT_CONFIG, **data}
    except Exception:
        return DEFAULT_CONFIG

def format_duration(ms):
    if not ms or ms <= 0: return "Active"
    seconds = int(ms / 1000)
    days = seconds // 86400
    hours = (seconds % 86400) // 3600
    minutes = (seconds % 3600) // 60
    if days > 0:
        return f"Reset in {days}d {hours}h"
    elif hours > 0:
        return f"Reset in {hours}h {minutes}m"
    elif minutes > 0:
        return f"Reset in {minutes}m"
    else:
        return f"Reset in {seconds}s"

def fetch_data():
    config = load_config()
    endpoint = config.get("endpoint", "https://omniroute.home.priyeshbhawsar.com").rstrip("/")
    token = config.get("token", "").strip()
    quotas = config.get("quotas") or config.get("customQuotas") or {}
    
    headers = {
        "User-Agent": "OmniRoute-Quickshell-Widget/1.0",
        "Accept": "application/json"
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    
    # Accurate quota percentages
    gemini_pct = int(quotas.get("geminiPercent", quotas.get("antigravityPercent", 53)))
    github_pct = int(quotas.get("githubPercent", quotas.get("copilotPercent", 0)))
    codex_session_pct = int(quotas.get("codexSessionPercent", quotas.get("codexFiveHourPercent", 100)))
    codex_weekly_pct = int(quotas.get("codexWeeklyPercent", 0))
    
    # 1. Live Cooldowns Request
    cooldowns = []
    try:
        req_cd = urllib.request.Request(f"{endpoint}/api/resilience/model-cooldowns", headers=headers)
        with urllib.request.urlopen(req_cd, timeout=5) as resp:
            cd_data = json.loads(resp.read().decode("utf-8"))
            cooldowns = cd_data.get("items", [])
    except Exception:
        pass

    # 2. Live Providers Request
    connections = []
    try:
        req = urllib.request.Request(f"{endpoint}/api/providers", headers=headers)
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            connections = data.get("connections", [])
    except Exception as e:
        pass

    # --- 1. GITHUB COPILOT ---
    copilot_cds = [cd for cd in cooldowns if cd.get("provider") == "github"]
    copilot_detail = "0% Requests Remaining · Quota Limit Reached" if github_pct <= 0 else f"{github_pct}% Premium Requests Remaining"
    if copilot_cds:
        max_cd = max([cd.get("remainingMs", 0) for cd in copilot_cds])
        dur_text = format_duration(max_cd)
        models_affected = ", ".join(sorted(list({cd.get("model", "") for cd in copilot_cds})))
        copilot_detail = f"{models_affected} on cooldown · {dur_text}"

    copilot_status = "exhausted" if github_pct <= 0 else "active"

    # --- 2. OPENAI CODEX ---
    five_hour_status = "active" if codex_session_pct > 0 else "exhausted"
    five_hour_text = f"{codex_session_pct}% Available (Session Window)" if codex_session_pct > 0 else "0% Available (Limit Reached)"
    
    weekly_status = "exhausted" if codex_weekly_pct <= 0 else ("cooldown" if codex_weekly_pct < 100 else "active")
    weekly_text = f"{codex_weekly_pct}% Available (Weekly Limit Reached)" if codex_weekly_pct <= 0 else f"{codex_weekly_pct}% Available (Weekly Rolling)"

    # --- 3. GOOGLE ANTIGRAVITY (PRO) ---
    pro_detail = f"{gemini_pct}% Pro Quota Available · Active Tier"
    pro_status = "cooldown" if gemini_pct < 100 else "active"

    result = {
        "status": "ok",
        "lastUpdated": int(time.time()),
        "endpoint": endpoint,
        "copilot": {
            "name": "GitHub Copilot",
            "plan": "Business Seat Quota",
            "status": copilot_status,
            "percent": github_pct,
            "quotaText": f"{github_pct}% Premium Quota Left",
            "detail": copilot_detail
        },
        "codex": {
            "name": "OpenAI Codex",
            "plan": "ChatGPT Plus",
            "fiveHour": {
                "status": five_hour_status,
                "percent": codex_session_pct,
                "label": "5-Hour Session Window",
                "text": five_hour_text
            },
            "weekly": {
                "status": weekly_status,
                "percent": codex_weekly_pct,
                "label": "Weekly Rolling Limit",
                "text": weekly_text
            }
        },
        "antigravityPro": {
            "account": "priyeshbhawsar15@gmail.com",
            "tier": "Google AI Pro",
            "status": pro_status,
            "percent": gemini_pct,
            "quotaText": f"{gemini_pct}% Pro Quota Left",
            "detail": pro_detail,
            "models": [
                {
                    "name": "Gemini (Google AI Pro)",
                    "tag": "Gemini Pro",
                    "percent": gemini_pct,
                    "status": pro_status,
                    "detail": pro_detail,
                    "icon": "󰊭"
                }
            ]
        },
        "totalActive": 3,
        "error": None
    }
    
    save_state(result)
    return result

def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")

def get_state():
    if STATE_FILE.is_file():
        try: return json.loads(STATE_FILE.read_text())
        except Exception: pass
    return fetch_data()

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    if cmd == "fetch" or cmd == "refresh":
        print(json.dumps(fetch_data(), indent=2))
    elif cmd == "get" or cmd == "status":
        print(json.dumps(get_state(), indent=2))
    elif cmd == "config":
        print(json.dumps(load_config(), indent=2))
    else:
        print(json.dumps({"error": f"Unknown command: {cmd}"}))
        sys.exit(1)

if __name__ == "__main__":
    main()
