#!/usr/bin/env python3
"""Fetch truthful provider quota telemetry from OmniRoute.

The Provider Limits API is the source of truth. No quota percentage is inferred
from connection state or cooldown absence: missing telemetry stays unavailable.
"""

import json
import math
import os
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/tmp"))
CONFIG_PATH = HOME / ".config/omarchy/omniroute-quota.json"
STATE_DIR = HOME / ".local/state/omarchy/omniroute-quota"
STATE_FILE = STATE_DIR / "state.json"

DEFAULT_CONFIG = {
    "endpoint": "https://omniroute.home.priyeshbhawsar.com",
    "token": "",
    "refreshIntervalSeconds": 60,
    "targetScreen": "DP-4",
    "position": "top-right",
    "width": 390,
    "topMargin": 48,
    "rightMargin": 16,
}


def load_config():
    if not CONFIG_PATH.is_file():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return dict(DEFAULT_CONFIG)
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return {**DEFAULT_CONFIG, **data}
    except Exception:
        return dict(DEFAULT_CONFIG)


def request_json(endpoint, token, path, method="GET", timeout=120):
    headers = {
        "User-Agent": "OmniRoute-Quickshell-Widget/2.0",
        "Accept": "application/json",
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(
        f"{endpoint.rstrip('/')}{path}", headers=headers, method=method
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def clamp_percent(value):
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    if not math.isfinite(number):
        return None
    return round(max(0.0, min(100.0, number)), 1)


def quota_percent(quota):
    if not isinstance(quota, dict):
        return None
    if quota.get("unlimited") is True:
        return 100.0
    percent = clamp_percent(quota.get("remainingPercentage"))
    if percent is not None:
        return percent
    remaining = quota.get("remaining")
    total = quota.get("total")
    try:
        remaining_number = float(remaining)
        total_number = float(total)
        if total_number > 0:
            return clamp_percent((remaining_number / total_number) * 100)
    except (TypeError, ValueError):
        pass
    try:
        used_number = float(quota.get("used"))
        total_number = float(total)
        if total_number > 0:
            return clamp_percent(((total_number - used_number) / total_number) * 100)
    except (TypeError, ValueError):
        pass
    return None


def format_percent(value):
    if value is None:
        return "—"
    if float(value).is_integer():
        return str(int(value))
    return f"{value:.1f}"


def parse_time(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except (TypeError, ValueError):
        return None


def reset_text(reset_at):
    reset = parse_time(reset_at)
    if reset is None:
        return "Reset unavailable"
    seconds = max(0, int((reset - datetime.now(timezone.utc)).total_seconds()))
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes = seconds // 60
    if days:
        return f"Resets in {days}d {hours}h"
    if hours:
        return f"Resets in {hours}h {minutes}m"
    if minutes:
        return f"Resets in {minutes}m"
    return f"Resets in {seconds}s"


def compact_reset_text(reset_at):
    text = reset_text(reset_at)
    return text.replace("Resets in ", "") if text.startswith("Resets in ") else text


def quota_status(percent, active=True, available=True):
    if not active:
        return "disabled"
    if not available or percent is None:
        return "unavailable"
    if percent <= 0:
        return "exhausted"
    if percent <= 2:
        return "approaching_limit"
    return "active"


def unavailable_copilot(message="Provider quota unavailable"):
    return {
        "name": "GitHub Copilot",
        "plan": "Unknown",
        "status": "unavailable",
        "percent": 0,
        "quotaText": "Data unavailable",
        "detail": message,
    }


def unavailable_codex(message="Provider quota unavailable"):
    window = {
        "status": "unavailable",
        "percent": 0,
        "text": "Data unavailable",
        "resetIn": message,
    }
    return {
        "name": "OpenAI Codex",
        "plan": "Unknown",
        "fiveHour": {**window, "label": "5-Hour Session Window"},
        "weekly": {**window, "label": "Weekly Rolling Limit"},
    }


def unavailable_antigravity(message="Provider quota unavailable"):
    return {
        "account": "Active account",
        "tier": "Unknown",
        "status": "unavailable",
        "percent": 0,
        "quotaText": "Data unavailable",
        "detail": message,
        "models": [],
    }


def active_connection(connections, provider):
    return next(
        (
            item
            for item in connections
            if item.get("provider") == provider and item.get("isActive") is True
        ),
        None,
    )


def build_copilot(connection, cache):
    if not connection:
        data = unavailable_copilot("No active GitHub connection")
        data["status"] = "disabled"
        return data
    if not isinstance(cache, dict):
        return unavailable_copilot()
    quota = (cache.get("quotas") or {}).get("premium_interactions")
    percent = quota_percent(quota)
    available = isinstance(quota, dict)
    status = quota_status(percent, available=available)
    reset = reset_text(quota.get("resetAt")) if available else "Reset unavailable"
    return {
        "name": "GitHub Copilot",
        "plan": cache.get("plan") or "Unknown",
        "status": status,
        "percent": percent if percent is not None else 0,
        "quotaText": f"{format_percent(percent)}% Available" if percent is not None else "Data unavailable",
        "detail": reset if available else (cache.get("message") or "Provider quota unavailable"),
    }


def build_codex_window(quota, label):
    percent = quota_percent(quota)
    available = isinstance(quota, dict)
    reset_at = quota.get("resetAt") if available else None
    reset = reset_text(reset_at) if available else "Reset unavailable"
    return {
        "status": quota_status(percent, available=available),
        "percent": percent if percent is not None else 0,
        "label": label,
        "text": (
            f"{format_percent(percent)}% · {compact_reset_text(reset_at)}"
            if percent is not None
            else "Data unavailable"
        ),
        "resetIn": reset,
    }


def build_codex(connection, cache):
    if not connection:
        data = unavailable_codex("No active Codex connection")
        data["fiveHour"]["status"] = "disabled"
        data["weekly"]["status"] = "disabled"
        return data
    if not isinstance(cache, dict):
        return unavailable_codex()
    quotas = cache.get("quotas") or {}
    return {
        "name": "OpenAI Codex",
        "plan": f"ChatGPT {str(cache.get('plan') or 'Unknown').title()}",
        "fiveHour": build_codex_window(quotas.get("session"), "5-Hour Session Window"),
        "weekly": build_codex_window(quotas.get("weekly"), "Weekly Rolling Limit"),
    }


def build_antigravity(connection, cache):
    if not connection:
        data = unavailable_antigravity("No active Antigravity connection")
        data["status"] = "disabled"
        return data
    account = connection.get("email") or connection.get("name") or "Active account"
    if not isinstance(cache, dict):
        data = unavailable_antigravity()
        data["account"] = account
        return data
    quotas = cache.get("quotas") or {}
    models = []
    for name, quota in quotas.items():
        if not str(name).startswith("gemini"):
            continue
        percent = quota_percent(quota)
        if percent is None:
            continue
        models.append(
            {
                "name": str(name),
                "tag": "Gemini Pro",
                "percent": percent,
                "status": quota_status(percent),
                "detail": reset_text(quota.get("resetAt")),
                "resetAt": quota.get("resetAt"),
                "icon": "󰊭",
            }
        )
    if not models:
        data = unavailable_antigravity(cache.get("message") or "Gemini quota unavailable")
        data.update({"account": account, "tier": cache.get("plan") or "Unknown"})
        return data
    percent = min(model["percent"] for model in models)
    earliest = min(
        (parse_time(model.get("resetAt")) for model in models if parse_time(model.get("resetAt"))),
        default=None,
    )
    reset = reset_text(earliest.isoformat()) if earliest else "Reset unavailable"
    return {
        "account": account,
        "tier": cache.get("plan") or "Unknown",
        "status": quota_status(percent),
        "percent": percent,
        "quotaText": f"{format_percent(percent)}% Available",
        "detail": reset,
        "models": models,
    }


def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")


def fetch_data(live_refresh=False):
    config = load_config()
    endpoint = str(config.get("endpoint") or DEFAULT_CONFIG["endpoint"]).rstrip("/")
    token = str(config.get("token") or "").strip()
    now = int(time.time())
    result = {
        "status": "ok",
        "lastUpdated": now,
        "endpoint": endpoint,
        "source": "provider-limits",
        "liveRefresh": bool(live_refresh),
        "copilot": unavailable_copilot(),
        "codex": unavailable_codex(),
        "antigravityPro": unavailable_antigravity(),
        "totalActive": 0,
        "error": None,
    }
    try:
        providers_payload = request_json(endpoint, token, "/api/providers", timeout=15)
        limits_payload = request_json(
            endpoint,
            token,
            "/api/usage/provider-limits",
            method="POST" if live_refresh else "GET",
            timeout=120 if live_refresh else 15,
        )
        connections = providers_payload.get("connections") or []
        caches = limits_payload.get("caches") or {}
        github = active_connection(connections, "github")
        codex = active_connection(connections, "codex")
        antigravity = active_connection(connections, "antigravity")
        result["copilot"] = build_copilot(github, caches.get(github.get("id")) if github else None)
        result["codex"] = build_codex(codex, caches.get(codex.get("id")) if codex else None)
        result["antigravityPro"] = build_antigravity(
            antigravity, caches.get(antigravity.get("id")) if antigravity else None
        )
        result["totalActive"] = sum(bool(item) for item in (github, codex, antigravity))
        result["providerLimitsFetchedAt"] = max(
            (
                str(caches.get(item.get("id"), {}).get("fetchedAt") or "")
                for item in (github, codex, antigravity)
                if item
            ),
            default="",
        )
        errors = limits_payload.get("errors") or {}
        if errors:
            result["status"] = "partial"
            result["error"] = f"{len(errors)} provider refresh(es) failed"
    except Exception as error:
        result["status"] = "error"
        result["error"] = str(error)
    save_state(result)
    return result


def get_state():
    if STATE_FILE.is_file():
        try:
            return json.loads(STATE_FILE.read_text())
        except Exception:
            pass
    return fetch_data(live_refresh=False)


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "get"
    if command == "refresh":
        output = fetch_data(live_refresh=True)
    elif command == "fetch":
        output = fetch_data(live_refresh=False)
    elif command in ("get", "status"):
        output = get_state()
    elif command == "config":
        output = load_config()
        if output.get("token"):
            output["token"] = "<configured>"
    else:
        output = {"error": f"Unknown command: {command}"}
        print(json.dumps(output))
        return 1
    print(json.dumps(output, indent=2))
    return 0 if output.get("status") != "error" else 1


if __name__ == "__main__":
    raise SystemExit(main())
