#!/usr/bin/env python3
import sys
import os
import json
import time
import urllib.request
import urllib.error
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/tmp"))
CONFIG_PATH = HOME / ".config/omarchy/omniroute-quota.json"
STATE_DIR = HOME / ".local/state/omarchy/omniroute-quota"
STATE_FILE = STATE_DIR / "state.json"

DEFAULT_CONFIG = {
    "endpoint": "https://omniroute.home.priyeshbhawsar.com",
    "token": "sk-cbd864e458119963-45d2d6-e35a047c",
    "refreshIntervalSeconds": 60,
    "targetScreen": "DP-4",
    "position": "top-right",
    "width": 320,
    "topMargin": 40,
    "rightMargin": 16
}

def load_config():
    if not CONFIG_PATH.is_file():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return DEFAULT_CONFIG
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return {**DEFAULT_CONFIG, **data}
    except Exception:
        return DEFAULT_CONFIG

def format_duration(ms):
    if not ms or ms <= 0: return ""
    seconds = int(ms / 1000)
    hours = seconds // 3600
    minutes = (seconds % 3600) // 60
    if hours > 0:
        return f"Reset in {hours}h {minutes}m"
    elif minutes > 0:
        return f"Reset in {minutes}m"
    else:
        return f"Reset in {seconds}s"

def fetch_data():
    config = load_config()
    endpoint = config.get("endpoint", "https://omniroute.home.priyeshbhawsar.com").rstrip("/")
    token = config.get("token", "").strip()
    
    headers = {
        "User-Agent": "OmniRoute-Quickshell-Widget/1.0",
        "Accept": "application/json"
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    
    result = {
        "status": "ok",
        "lastUpdated": int(time.time()),
        "endpoint": endpoint,
        "providers": [],
        "totalActive": 0,
        "authNotice": "",
        "error": None
    }
    
    # Query cooldowns
    cooldowns = {}
    try:
        req_cd = urllib.request.Request(f"{endpoint}/api/resilience/model-cooldowns", headers=headers)
        with urllib.request.urlopen(req_cd, timeout=5) as resp:
            cd_data = json.loads(resp.read().decode("utf-8"))
            items = cd_data.get("items", [])
            for item in items:
                conn_id = item.get("connectionId")
                provider_name = item.get("provider")
                key = conn_id or provider_name
                cooldowns[key] = item
    except Exception:
        pass

    # Query connections from /api/providers
    try:
        req = urllib.request.Request(f"{endpoint}/api/providers", headers=headers)
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            connections = data.get("connections", [])
            providers_list = []
            
            for c in connections:
                provider_id = c.get("provider", "unknown")
                conn_id = c.get("id", "")
                is_active = c.get("isActive", True)
                test_status = c.get("testStatus", "active")
                p_data = c.get("providerSpecificData") or {}
                
                # Plan / Tier
                plan_name = p_data.get("subscriptionTier") or p_data.get("plan") or p_data.get("workspacePlanType") or ""
                if plan_name: plan_name = plan_name.title()
                
                # Cooldown / Quota check
                cd_info = cooldowns.get(conn_id) or cooldowns.get(provider_id)
                percent = 100
                reset_text = plan_name if plan_name else "Active"
                status = "active" if (is_active and test_status == "active") else "inactive"
                
                if cd_info:
                    reason = cd_info.get("reason", "cooldown")
                    rem_ms = cd_info.get("remainingMs", 0)
                    percent = 0 if reason == "quota_exhausted" else 20
                    reset_text = f"Quota Low · {format_duration(rem_ms)}" if rem_ms > 0 else "Quota Low"
                    status = "exhausted" if percent == 0 else "cooldown"
                elif not is_active:
                    percent = 0
                    reset_text = "Disabled"
                    status = "disabled"
                
                # Clean display name
                name_map = {
                    "github": "GitHub Copilot",
                    "antigravity": "Google Antigravity",
                    "codex": "OpenAI Codex",
                    "chatgpt-web": "ChatGPT Web",
                    "openrouter": "OpenRouter",
                    "aihorde": "AI Horde"
                }
                display_name = name_map.get(provider_id, provider_id.replace("-", " ").title())
                if plan_name and plan_name not in display_name:
                    display_name += f" ({plan_name})"
                
                providers_list.append({
                    "id": conn_id or provider_id,
                    "provider": provider_id,
                    "name": display_name,
                    "plan": plan_name,
                    "status": status,
                    "quotaPercent": percent,
                    "resetIn": reset_text,
                    "isActive": is_active
                })
            
            # Sort: active/healthy first, then cooldown/disabled
            providers_list.sort(key=lambda x: (0 if x["status"] == "active" else 1, x["name"]))
            result["providers"] = providers_list
            result["totalActive"] = len([p for p in providers_list if p["status"] == "active"])
            save_state(result)
            return result
    except Exception as e:
        result["status"] = "error"
        result["error"] = str(e)
        save_state(result)
        return result

def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")

def get_state():
    if STATE_FILE.is_file():
        try: return json.loads(STATE_FILE.read_text())
        except Exception: pass
    return fetch_data()

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    if cmd == "fetch" or cmd == "refresh":
        print(json.dumps(fetch_data(), indent=2))
    elif cmd == "get" or cmd == "status":
        print(json.dumps(get_state(), indent=2))
    elif cmd == "config":
        print(json.dumps(load_config(), indent=2))
    else:
        print(json.dumps({"error": f"Unknown command: {cmd}"}))
        sys.exit(1)

if __name__ == "__main__":
    main()
