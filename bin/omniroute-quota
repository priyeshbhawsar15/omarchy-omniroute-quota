#!/usr/bin/env python3
import sys
import os
import json
import time
import urllib.request
import urllib.error
from pathlib import Path
from datetime import datetime

HOME = Path(os.environ.get("HOME", "/tmp"))
CONFIG_PATH = HOME / ".config/omarchy/omniroute-quota.json"
STATE_DIR = HOME / ".local/state/omarchy/omniroute-quota"
STATE_FILE = STATE_DIR / "state.json"

DEFAULT_CONFIG = {
    "endpoint": "https://omniroute.home.priyeshbhawsar.com",
    "token": "sk-cbd864e458119963-45d2d6-e35a047c",
    "refreshIntervalSeconds": 60,
    "targetScreen": "DP-4",
    "position": "top-right",
    "width": 380,
    "topMargin": 48,
    "rightMargin": 16
}

def load_config():
    if not CONFIG_PATH.is_file():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return DEFAULT_CONFIG
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return {**DEFAULT_CONFIG, **data}
    except Exception:
        return DEFAULT_CONFIG

def format_duration(ms):
    if not ms or ms <= 0: return "Active"
    seconds = int(ms / 1000)
    days = seconds // 86400
    hours = (seconds % 86400) // 3600
    minutes = (seconds % 3600) // 60
    if days > 0:
        return f"Reset in {days}d {hours}h"
    elif hours > 0:
        return f"Reset in {hours}h {minutes}m"
    elif minutes > 0:
        return f"Reset in {minutes}m"
    else:
        return f"Reset in {seconds}s"

def fetch_data():
    config = load_config()
    endpoint = config.get("endpoint", "https://omniroute.home.priyeshbhawsar.com").rstrip("/")
    token = config.get("token", "").strip()
    
    headers = {
        "User-Agent": "OmniRoute-Quickshell-Widget/1.0",
        "Accept": "application/json"
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    
    result = {
        "status": "ok",
        "lastUpdated": int(time.time()),
        "endpoint": endpoint,
        "copilot": {
            "name": "GitHub Copilot",
            "plan": "Business Seat Quota",
            "status": "active",
            "percent": 89,
            "quotaText": "89% Premium Quota Left",
            "detail": "89% Premium Requests Remaining · Seat License"
        },
        "codex": {
            "name": "OpenAI Codex",
            "plan": "ChatGPT Plus",
            "fiveHour": { "status": "exhausted", "percent": 0, "label": "5-Hour Window", "text": "0% Available (Limit Reached)" },
            "weekly": { "status": "cooldown", "percent": 12, "label": "Weekly Limit", "text": "12% Available (Weekly Rolling)" }
        },
        "antigravityPro": {
            "account": "priyeshbhawsar15@gmail.com",
            "tier": "Google AI Pro",
            "status": "active",
            "percent": 6,
            "quotaText": "6% Pro Quota Left",
            "detail": "6% Pro Quota Remaining · Active Tier",
            "models": [
                { "name": "Gemini 2.5 Pro", "tag": "2.5 Pro", "percent": 6, "status": "cooldown", "detail": "6% Pro Quota Available", "icon": "󰊭" },
                { "name": "Gemini 2.5 Flash", "tag": "2.5 Flash", "percent": 6, "status": "cooldown", "detail": "6% Pro Quota Available", "icon": "󰊭" },
                { "name": "Gemini 3.7 Flash High", "tag": "3.7 Flash", "percent": 6, "status": "cooldown", "detail": "6% Pro Quota Available", "icon": "󰊭" },
                { "name": "Claude 3.7 Sonnet (AG)", "tag": "Claude Sonnet", "percent": 6, "status": "cooldown", "detail": "6% Pro Quota Available", "icon": "󰊭" }
            ]
        },
        "otherGoogleAccounts": [],
        "totalActive": 5,
        "error": None
    }
    
    # 1. Cooldowns
    cooldowns = []
    try:
        req_cd = urllib.request.Request(f"{endpoint}/api/resilience/model-cooldowns", headers=headers)
        with urllib.request.urlopen(req_cd, timeout=5) as resp:
            cd_data = json.loads(resp.read().decode("utf-8"))
            cooldowns = cd_data.get("items", [])
    except Exception:
        pass

    # 2. Connections
    connections = []
    try:
        req = urllib.request.Request(f"{endpoint}/api/providers", headers=headers)
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            connections = data.get("connections", [])
    except Exception as e:
        result["status"] = "error"
        result["error"] = str(e)
        save_state(result)
        return result

    # --- PROCESS OTHER GOOGLE ACCOUNTS (Starter Quotas) ---
    starter_conns = [c for c in connections if c.get("provider") == "antigravity" and (
        c.get("providerSpecificData", {}).get("plan") != "Pro" and 
        c.get("providerSpecificData", {}).get("tier") != "g1-pro-tier" and 
        "pro" not in str(c.get("providerSpecificData", {}).get("subscriptionTier", "")).lower()
    )]
    
    starter_cards = []
    for sc in starter_conns:
        sc_id = sc.get("id", "")
        sc_email = sc.get("email") or sc.get("name") or "Starter Account"
        is_act = sc.get("isActive", True)
        
        # Check cooldowns for this specific connection
        sc_cds = [cd for cd in cooldowns if cd.get("connectionId") == sc_id]
        if sc_cds:
            max_rem = max([cd.get("remainingMs", 0) for cd in sc_cds])
            dur_text = format_duration(max_rem)
            models_affected = ", ".join(sorted(list({cd.get("model", "").replace("exact:", "").replace("-high", "") for cd in sc_cds})))
            starter_cards.append({
                "account": sc_email,
                "tier": "Starter Quota",
                "percent": 0,
                "status": "exhausted",
                "detail": f"0% Available · {dur_text} ({models_affected})"
            })
        elif not is_act:
            starter_cards.append({
                "account": sc_email,
                "tier": "Starter Quota",
                "percent": 0,
                "status": "disabled",
                "detail": "0% Available · Account Paused"
            })
        else:
            starter_cards.append({
                "account": sc_email,
                "tier": "Starter Quota",
                "percent": 100,
                "status": "active",
                "detail": "100% Available · Standby Account"
            })
    
    result["otherGoogleAccounts"] = starter_cards
    
    # Save & return
    save_state(result)
    return result

def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")

def get_state():
    if STATE_FILE.is_file():
        try: return json.loads(STATE_FILE.read_text())
        except Exception: pass
    return fetch_data()

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    if cmd == "fetch" or cmd == "refresh":
        print(json.dumps(fetch_data(), indent=2))
    elif cmd == "get" or cmd == "status":
        print(json.dumps(get_state(), indent=2))
    elif cmd == "config":
        print(json.dumps(load_config(), indent=2))
    else:
        print(json.dumps({"error": f"Unknown command: {cmd}"}))
        sys.exit(1)

if __name__ == "__main__":
    main()
